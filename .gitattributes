*.html linguist-detectable=false

# git archive (GitHub "Download ZIP", git archive HEAD) substitutes
# $Format:%H$-style placeholders in this file at archive time. Gives
# us the actual commit SHA in ZIP-download bench bundles where the
# .git directory is absent, sidestepping the "Git: unknown" gap in
# startup logging. See src/_lumascope/lvp_logger.py for the runtime reader.
.git_archival.txt export-subst
# The commit judge reads each hunk with its whole enclosing def (git diff -W).
*.py diff=python
# The user manual is source for its PDF, not for running LVP: its images
# stay out of every source archive (GitHub "Download ZIP", git archive).
docs/manual export-ignore
# The Lumascope Classic driver package is signed: its catalog holds the INF's
# hash, so a checkout that changed either file's line endings would ship a
# package Windows refuses. Both are committed as signed, byte for byte.
scripts/appBuild/build_exe/fx2_driver/Lumascope_Classic.inf -text
scripts/appBuild/build_exe/fx2_driver/Lumascope_Classic.cat -text
