[
  {"do":"answer","button":"OK","optional":true,"timeout_s":15},
  {"do":"wait","settle_s":3},
  {"do":"press","path":"MotionSettings/motionsettings_protocol_accordion_id","settle_s":2},
  {"do":"select","path":"ProtocolSettings/labware_spinner","value":"6 well microplate","settle_s":2},
  {"do":"press","path":"ChannelDrawer[channel=BF]/control/acquire_image","note":"one channel set to acquire"},
  {"do":"select","path":"ProtocolSettings/tiling_size_spinner","value":"2x2","settle_s":1},
  {"do":"press","path":"ProtocolSettings/RoundedButton[text=New]","settle_s":2,"note":"6 wells x 4 tiles x 1 channel = 24 steps"},
  {"do":"wait","timeout_s":30},
  {"do":"read","path":"ProtocolSettings/step_total_input","props":["text"]},
  {"do":"read","path":"ProtocolSettings/step_name_input","props":["text"]},
  {"do":"type","path":"ProtocolSettings/capture_root","text":"plate1","commit":true,"settle_s":1},
  {"do":"press","path":"ProtocolSettings/Label[text=Enable Z-Stack]","settle_s":1,"note":"a label: the press only scrolls the panel down"},
  {"do":"shot","name":"../images/protocol-panel-steps-ls850","path":"MotionSettings/motionsettings_protocol_accordion_id","note":"the drawer alone, scrolled to its step editor"},
  {"do":"select","path":"ProtocolSettings/tiling_size_spinner","value":"3x3","settle_s":1},
  {"do":"press","path":"ProtocolSettings/tiling_size_apply_id","settle_s":1,"note":"a tiled protocol is not tiled again"},
  {"do":"answer","button":"OK","timeout_s":10},
  {"do":"read","path":"ProtocolSettings/step_total_input","props":["text"]},
  {"do":"press","path":"ProtocolSettings/run_scan_btn","settle_s":2},
  {"do":"wait","timeout_s":300},
  {"do":"quit"}
]
