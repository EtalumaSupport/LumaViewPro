diff --git a/extmod/vfs_posix_file.c b/extmod/vfs_posix_file.c
index 837c548..eeece62 100644
--- a/extmod/vfs_posix_file.c
+++ b/extmod/vfs_posix_file.c
@@ -35,6 +35,45 @@
 #include <fcntl.h>
 #include <unistd.h>
 
+#if !defined(_WIN32)
+#include <errno.h>
+#include <signal.h>
+#include <sys/select.h>
+
+// Wait for stdin with SIGINT deliverable only inside the wait. A SIGINT only
+// schedules KeyboardInterrupt, and the VM checks for it at jumps and on EINTR,
+// so one that lands between the last check and a blocking read() stays pending
+// until the next input byte arrives. Checking with SIGINT blocked and then
+// waiting in pselect(), which unblocks it atomically, closes that window: the
+// interrupt fires while the program waits for input, as it does on a board.
+STATIC void vfs_posix_stdin_wait(int fd) {
+    for (;;) {
+        sigset_t sigint, orig;
+        sigemptyset(&sigint);
+        sigaddset(&sigint, SIGINT);
+        sigprocmask(SIG_BLOCK, &sigint, &orig);
+        if (MP_STATE_THREAD(mp_pending_exception) != MP_OBJ_NULL) {
+            sigprocmask(SIG_SETMASK, &orig, NULL);
+            mp_handle_pending(true);
+            continue;
+        }
+        fd_set rfds;
+        FD_ZERO(&rfds);
+        FD_SET(fd, &rfds);
+        MP_THREAD_GIL_EXIT();
+        int ret = pselect(fd + 1, &rfds, NULL, NULL, NULL, &orig);
+        int err = errno;
+        MP_THREAD_GIL_ENTER();
+        sigprocmask(SIG_SETMASK, &orig, NULL);
+        if (ret > 0 || (ret < 0 && err != EINTR)) {
+            // Readable, or an error the read itself will report.
+            return;
+        }
+        mp_handle_pending(true);
+    }
+}
+#endif
+
 #ifdef _WIN32
 #define fsync _commit
 #else
@@ -138,6 +177,11 @@ STATIC MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(vfs_posix_file___exit___obj, 4, 4, vf
