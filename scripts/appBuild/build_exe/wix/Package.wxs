<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<!-- These variables can be overridden via -d command line arguments -->
	<?ifndef ProductName ?>
		<?define ProductName = "LumaViewPro 3.0.0-beta" ?>
	<?endif ?>
	<?ifndef Version ?>
		<?define Version = "3.0.0" ?>
	<?endif ?>
	<!-- Version must be in format x.x.x -->
	<?ifndef Manufacturer ?>
		<?define Manufacturer = "Etaluma" ?>
	<?endif ?>
	<?ifndef InstallFolderDir ?>
		<?define InstallFolderDir = "path" ?>
	<?endif ?>
	<?ifndef InstallerAssetsDir ?>
		<?define InstallerAssetsDir = "$(var.InstallFolderDir)" ?>
	<?endif ?>
	
  <Package Name="$(var.ProductName)" Manufacturer="$(var.Manufacturer)" Version="$(var.Version)" Compressed="yes" UpgradeCode="90907569-ca5a-4e20-b393-2e042e9f8b93" InstallerVersion="500">
    <!-- Embed cabinet files inside the MSI so it's a single file for distribution -->
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please uninstall the newer version before installing this version." />
	  <DirectoryRef Id="INSTALLFOLDER">
		  <!-- 
		  INSTALLFOLDER goes to ProgramFiles LVP folder.
		  Make sure that the directory to the desired base LVP folder is correct and has \** after in order to include all in folder
	      -->
		<Files Include="$(var.InstallFolderDir)\**" />
		  <Component Id="MarkerFileComponent" Guid="f5103a8e-44d6-4214-aa02-73843c670f6d">
			  <File Id="MarkerFile"
					Name="marker.lvpinstalled"
					Source="$(var.ProjectDir)\marker.lvpinstalled"
					KeyPath="yes"
					Vital="yes" />
		  </Component>
		  
		  <Component Id="LVPINSTALLFOLDERComponent" Guid="7c20a30c-6247-43ea-bdf6-8bf1b915fdd3">
			  <RemoveFolder Id="INSTALLFOLDER" On="uninstall" />
		  </Component>
	  </DirectoryRef>
	  
	  <!-- Make sure to update icon directory -->
	  <Icon Id="icon.ico" SourceFile="$(var.InstallerAssetsDir)\data\icons\icon.ico"/>
	  <Property Id="ARPPRODUCTICON" Value="icon.ico" />
	  <DirectoryRef Id="ApplicationProgramsFolder">
		  <Component Id="ApplicationShortcut" Guid="90907569-ca5a-4e20-b393-2e042e9f8b93">
			  <Shortcut Id="ApplicationStartMenuShortcut"
						Name="$(var.ProductName)"
						Description="Etaluma LumaViewPro"
						Target="[INSTALLFOLDER]lumaviewpro.exe"
						WorkingDirectory="INSTALLFOLDER"/>
			  <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
			  <RegistryValue Root="HKCU" Key="Software\Etaluma\LumaViewPro" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
		  </Component>
	  </DirectoryRef>

	  <!-- Desktop shortcut. KeyPath has to be the registry value (not the
	       shortcut itself) because non-advertised shortcuts can't be
	       KeyPaths. RemoveFolder is unnecessary — the desktop is a system
	       folder, not one we created. -->
	  <StandardDirectory Id="DesktopFolder">
		  <Component Id="ApplicationDesktopShortcut" Guid="d9f1c4e2-7a8b-4e1f-9c3a-5b6d8e2f1a4c">
			  <Shortcut Id="DesktopShortcut"
						Name="$(var.ProductName)"
						Description="Etaluma LumaViewPro"
						Target="[INSTALLFOLDER]lumaviewpro.exe"
						WorkingDirectory="INSTALLFOLDER"
						Icon="icon.ico"
						IconIndex="0"/>
			  <RegistryValue Root="HKCU" Key="Software\Etaluma\LumaViewPro" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
		  </Component>
	  </StandardDirectory>
	  
	  <Component Id="pathComponentLVPInstall" Guid="e2ae148c-3520-454f-9cf7-4f5aca7ca6bd" KeyPath="yes">
		  <CreateFolder />
		  <Environment Id="LVPINSTALL" Name="LVP_INSTALLED" Value="True" Permanent="no" Part="last" Action="set" System="yes"/>

	  </Component>

	  <Component Id="GpuPref" Guid="b5b58055-9c6d-4b4b-af22-7bc48ba14702">
		  <RegistryValue
			Root="HKCU"
			Key="Software\Microsoft\DirectX\UserGpuPreferences"
			Name="[INSTALLFOLDER]LumaViewPro.exe"
			Type="string"
			Value="GpuPreference=2;"
			Action="write" />
	  </Component>

	  <!--
	    Optional: FX2 WinUSB driver for LVC cameras (LS560/LS620/LS720).
	    Install the INF to a known subfolder and run pnputil /add-driver
	    after files are laid down. The build script defines Fx2InfPath only
	    when an INF is present in dependencies\fx2\; absence -> this entire
	    block is preprocessed out and the MSI has no FX2 install action.

	    NOTE: pnputil requires admin. The MSI already runs elevated, so the
	    deferred action runs as SYSTEM. Errors are ignored (Return="ignore")
	    so a missing driver-install doesn't block the rest of LVP setup.
	  -->
	  <?ifdef Fx2InfPath ?>
	  <DirectoryRef Id="INSTALLFOLDER">
	    <Directory Id="Fx2DriverDir" Name="drivers">
	      <Directory Id="Fx2DriverSubDir" Name="fx2">
	        <Component Id="Fx2WinUSBInfFile" Guid="3a7b5f48-9e2a-4d1c-bf67-2ca1d8fe9e10">
	          <File Id="Fx2WinUSBInf"
	                Source="$(var.Fx2InfPath)"
	                KeyPath="yes" />
	        </Component>
	      </Directory>
	    </Directory>
	  </DirectoryRef>

	  <CustomAction Id="InstallFx2Driver"
	                Directory="Fx2DriverSubDir"
	                ExeCommand="[System64Folder]pnputil.exe /add-driver &quot;[#Fx2WinUSBInf]&quot; /install"
	                Execute="deferred"
	                Impersonate="no"
	                Return="ignore" />

	  <InstallExecuteSequence>
	    <Custom Action="InstallFx2Driver" After="InstallFiles" Condition="NOT REMOVE" />
	  </InstallExecuteSequence>
	  <?endif ?>

  </Package>
</Wix>
