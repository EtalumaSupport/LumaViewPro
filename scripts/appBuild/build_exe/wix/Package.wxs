<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<!-- These variables can be overridden via -d command line arguments -->
	<?ifndef ProductName ?>
		<?define ProductName = "LumaViewPro 3.0.0-beta" ?>
	<?endif ?>
	<?ifndef Version ?>
		<?define Version = "3.0.0" ?>
	<?endif ?>
	<!-- Version must be in format x.x.x -->
	<?ifndef Manufacturer ?>
		<?define Manufacturer = "Etaluma" ?>
	<?endif ?>
	<?ifndef InstallFolderDir ?>
		<?define InstallFolderDir = "path" ?>
	<?endif ?>
	<?ifndef InstallerAssetsDir ?>
		<?define InstallerAssetsDir = "$(var.InstallFolderDir)" ?>
	<?endif ?>
	
  <Package Name="$(var.ProductName)" Manufacturer="$(var.Manufacturer)" Version="$(var.Version)" Compressed="yes" UpgradeCode="90907569-ca5a-4e20-b393-2e042e9f8b93" InstallerVersion="500" Scope="perMachine">
    <!-- Embed cabinet files inside the MSI so it's a single file for distribution -->
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please uninstall the newer version before installing this version." />
	  <DirectoryRef Id="INSTALLFOLDER">
		  <!-- 
		  INSTALLFOLDER goes to ProgramFiles LVP folder.
		  Make sure that the directory to the desired base LVP folder is correct and has \** after in order to include all in folder
	      -->
		<Files Include="$(var.InstallFolderDir)\**" />
		  <Component Id="MarkerFileComponent" Guid="f5103a8e-44d6-4214-aa02-73843c670f6d">
			  <File Id="MarkerFile"
					Name="marker.lvpinstalled"
					Source="$(var.ProjectDir)\marker.lvpinstalled"
					KeyPath="yes"
					Vital="yes" />
		  </Component>
		  
		  <Component Id="LVPINSTALLFOLDERComponent" Guid="7c20a30c-6247-43ea-bdf6-8bf1b915fdd3">
			  <RemoveFolder Id="INSTALLFOLDER" On="uninstall" />
		  </Component>
	  </DirectoryRef>
	  
	  <!-- Make sure to update icon directory -->
	  <Icon Id="icon.ico" SourceFile="$(var.InstallerAssetsDir)\data\icons\icon.ico"/>
	  <Property Id="ARPPRODUCTICON" Value="icon.ico" />
	  <DirectoryRef Id="ApplicationProgramsFolder">
		  <!-- Rotated once when ProductName stopped carrying the version.
		       The old GUID owns a Start Menu folder and shortcut named for
		       whichever release installed them; a component GUID may only
		       ever own one path, so the incoming build cannot adopt those
		       and must let them go. Rotating releases the old component so
		       its refcount reaches zero during the upgrade and Windows
		       Installer removes the stale folder. Now that the paths are
		       stable this GUID is permanent: rotating it again would
		       strand whatever it owns, which is the bug it just fixed.
		       It also used to duplicate the Package UpgradeCode above, and
		       one GUID naming two things is how that went unnoticed. -->
		  <Component Id="ApplicationShortcut" Guid="b07bc132-8c03-4178-8794-def33621ee92">
			  <Shortcut Id="ApplicationStartMenuShortcut"
						Name="$(var.ProductName)"
						Description="Etaluma LumaViewPro"
						Target="[INSTALLFOLDER]lumaviewpro.exe"
						WorkingDirectory="INSTALLFOLDER"/>
			  <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
			  <RegistryValue Root="HKCU" Key="Software\Etaluma\LumaViewPro" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
		  </Component>
	  </DirectoryRef>

	  <!-- Desktop shortcut. KeyPath has to be the registry value (not the
	       shortcut itself) because non-advertised shortcuts can't be
	       KeyPaths. RemoveFolder is unnecessary — the desktop is a system
	       folder, not one we created. -->
	  <StandardDirectory Id="DesktopFolder">
		  <!-- Rotated once alongside the Start Menu component above, and
		       permanent for the same reason: it releases the desktop
		       shortcut named for the previous release so the upgrade can
		       delete it instead of stranding it beside the new one. -->
		  <Component Id="ApplicationDesktopShortcut" Guid="c2a8bfcf-1afd-488a-b572-671e496efe26">
			  <Shortcut Id="DesktopShortcut"
						Name="$(var.ProductName)"
						Description="Etaluma LumaViewPro"
						Target="[INSTALLFOLDER]lumaviewpro.exe"
						WorkingDirectory="INSTALLFOLDER"
						Icon="icon.ico"
						IconIndex="0"/>
			  <RegistryValue Root="HKCU" Key="Software\Etaluma\LumaViewPro" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
		  </Component>
	  </StandardDirectory>
	  
	  <Component Id="pathComponentLVPInstall" Guid="e2ae148c-3520-454f-9cf7-4f5aca7ca6bd" KeyPath="yes">
		  <CreateFolder />
		  <Environment Id="LVPINSTALL" Name="LVP_INSTALLED" Value="True" Permanent="no" Part="last" Action="set" System="yes"/>

	  </Component>

	  <Component Id="GpuPref" Guid="b5b58055-9c6d-4b4b-af22-7bc48ba14702">
		  <RegistryValue
			Root="HKCU"
			Key="Software\Microsoft\DirectX\UserGpuPreferences"
			Name="[INSTALLFOLDER]LumaViewPro.exe"
			Type="string"
			Value="GpuPreference=2;"
			Action="write" />
	  </Component>

	  <!--
	    The FX2 WinUSB driver package for the Lumascope Classic (LS560/LS620/
	    LS720), installed to drivers\fx2\, in a signed build only: build.ps1
	    defines Fx2InfPath (the INF it stamped, fx2_driver_package.py) and
	    Fx2CatPath (its signed catalog) only when a signing certificate is
	    configured, since Windows accepts a driver package only with a signed
	    catalog.

	    The installer does not bind it. LumaViewPro's Repair runs the driver
	    step (lvp_fx2_driver_step.exe, modules/fx2_driver_step.py) on the
	    person's desktop, where Windows asks whether to install software from
	    Etaluma; an installer action runs as SYSTEM with no desktop to ask on.
	    Uninstall runs the step deferred and as SYSTEM, which removing a
	    package needs and no prompt does: it removes our package and restores
	    what Repair exported, logging to logs\driver_uninstall_<version>_<time>.log
	    under the install folder. Return="ignore": an installer action cannot
	    tell the person anything.

	    The uninstall step is skipped when a newer version is removing this one
	    (UPGRADINGPRODUCTCODE): an upgrade leaves our driver installed and
	    working, and only a full uninstall removes it.
	  -->
	  <?ifdef Fx2InfPath ?>
	  <DirectoryRef Id="INSTALLFOLDER">
	    <Directory Id="Fx2DriverDir" Name="drivers">
	      <Directory Id="Fx2DriverSubDir" Name="fx2">
	        <Component Id="Fx2WinUSBInfFile" Guid="3a7b5f48-9e2a-4d1c-bf67-2ca1d8fe9e10">
	          <File Id="Fx2WinUSBInf"
	                Source="$(var.Fx2InfPath)"
	                KeyPath="yes" />
	        </Component>
	        <Component Id="Fx2WinUSBCatFile" Guid="8c1e2f6a-4b7d-4e0a-9f35-6d2a71c4b8e3">
	          <File Id="Fx2WinUSBCat"
	                Source="$(var.Fx2CatPath)"
	                KeyPath="yes" />
	        </Component>
	      </Directory>
	    </Directory>
	  </DirectoryRef>

	  <CustomAction Id="UninstallFx2Driver"
	                Directory="INSTALLFOLDER"
	                ExeCommand="&quot;[INSTALLFOLDER]lvp_fx2_driver_step.exe&quot; uninstall"
	                Execute="deferred"
	                Impersonate="no"
	                Return="ignore" />

	  <InstallExecuteSequence>
	    <Custom Action="UninstallFx2Driver" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
	  </InstallExecuteSequence>
	  <?endif ?>

  </Package>
</Wix>
