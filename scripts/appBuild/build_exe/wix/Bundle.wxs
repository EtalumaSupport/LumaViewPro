<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
	<!-- These variables can be overridden via -d command line arguments -->
  <?ifndef ProductName ?>
  	<?define ProductName = "LumaViewPro 3.0.0-beta" ?>
  <?endif ?>
  <?ifndef ProductVersion ?>
  	<?define ProductVersion = "3.0.0" ?>
  <?endif ?>
  <?ifndef Manufacturer ?>
  	<?define Manufacturer = "Etaluma" ?>
  <?endif ?>
  <?ifndef LVPInstallFolderDir ?>
  	<?define LVPInstallFolderDir = "path" ?>
  <?endif ?>
  <?ifndef InstallerAssetsDir ?>
  	<?define InstallerAssetsDir = "$(var.LVPInstallFolderDir)" ?>
  <?endif ?>
  <?ifndef LVPMsiDir ?>
  	<?define LVPMsiDir = "LumaViewPro.msi" ?>
  <?endif ?>
  <?ifndef PylonDriverDir ?>
  	<?define PylonDriverDir = "pylon_USB_Camera_Driver.msi" ?>
  <?endif ?>
  <?ifndef VCRedistExe ?>
  	<?define VCRedistExe = "vc_redist.x64.exe" ?>
  <?endif ?>
	
  <Bundle Name="$(var.ProductName)"
		  Manufacturer="$(var.Manufacturer)"
		  Version="$(var.ProductVersion)"
		  UpgradeCode="c483d86a-624f-4279-8a06-b6b4039a6fff"
		  IconSourceFile="$(var.InstallerAssetsDir)\data\icons\icon.ico">
	  
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication 
          LicenseUrl="https://etaluma.com/terms-of-use/" 
          LogoSideFile="$(var.InstallerAssetsDir)\data\icons\installer_side_logo.png"
          Theme="hyperlinkSidebarLicense" 
          LogoFile="$(var.InstallerAssetsDir)\data\icons\icon.png" />
    </BootstrapperApplication>

    <!-- LumaViewPro's install folder, Folders.wxs's own default, named once
         here for the two packages that need it: the MSI installs into it and
         the Classic driver step logs into it. Formatted, so Burn resolves
         [ProgramFiles6432Folder] when the value is read; a plain string
         variable is passed on as its literal text. -->
    <Variable Name="InstallFolder" Value="[ProgramFiles6432Folder]$(var.ProductName)\" Type="formatted" />

    <Chain>
		<!-- VC++ Redistributable (x64). Required chain member: LVP no
		     longer ships msvcp140/concrt140 app-local (a stale bundled
		     copy shadows System32 for the whole process and broke the
		     IDS camera SDK's DLL init), so the system runtime must
		     provably exist on every machine we install to. vc_redist
		     self-handles re-runs: exit 1638 = same-or-newer already
		     installed (success for us); 3010 = installed, reboot
		     pending. -->
		<ExePackage Id="VCRedist"
					SourceFile="$(var.VCRedistExe)"
					Permanent="yes"
					PerMachine="yes"
					Vital="yes"
					InstallArguments="/install /quiet /norestart">
			<ExitCode Value="1638" Behavior="success" />
			<ExitCode Value="3010" Behavior="forceReboot" />
		</ExePackage>

		<MsiPackage Id="LVP"
					SourceFile="$(var.LVPMsiDir)"
					Vital="yes">
			<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
		</MsiPackage>

		<!--
		  The Lumascope Classic driver (LS460/LS560/LS620/LS720): a one-file
		  build of the driver step (src/_lumascope/modules/fx2_driver_step.py),
		  the INF and its signed catalog beside it, takes both of the scope's
		  USB identities on a PC that has had a Classic and changes nothing on
		  one that has not. Per-machine, so Burn runs it elevated on the
		  person's desktop, where Windows asks whether to install software
		  from Etaluma. Not vital: a declined prompt fails nothing, and
		  LumaViewPro's Repair completes it at launch. Permanent: uninstall is
		  the MSI's driver action. Run at every install and upgrade, so an
		  upgrade takes back what a package installed since took. build.ps1
		  defines Fx2InfPath only for a build that carries the package.
		-->
		<?ifdef Fx2InfPath ?>
		<ExePackage Id="Fx2DriverStep"
					SourceFile="$(var.Fx2DriverStepExe)"
					PerMachine="yes"
					Vital="no"
					Permanent="yes"
					DetectCondition="0"
					InstallArguments='install-if-classic "[InstallFolder]logs"'>
			<Payload SourceFile="$(var.Fx2InfPath)" />
			<Payload SourceFile="$(var.Fx2CatPath)" />
		</ExePackage>
		<?endif ?>

		<MsiPackage Id="PylonDriver"
					Permanent="yes"
					SourceFile="$(var.PylonDriverDir)" />
		<!-- Note: Pylon force-repair via MsiProperty REINSTALL=ALL was tried
		     in dc26684 but WiX 6 rejects REINSTALL / REINSTALLMODE inside a
		     bundle's MsiPackage (WIX0365: bootstrapper-controlled properties).
		     Orphaned-ProductCode case (driver INF removed via Device Manager
		     while MSI registration persists -> camera enumerates as unknown
		     USB device) requires a different mechanism; tracked as a separate
		     concern from the bench-build unblock. -->

		<!--
		  Optional: IDS Peak runtime (USB3 transport layer + drivers for IDS
		  cameras). InstallShield .exe needs a recorded setup.iss for silent
		  install. The build script defines IDSPeakExe + IDSPeakSetupIss only
		  when both files are present in dependencies\; absence -> this
		  package is simply not part of the chain.
		-->
		<?ifdef IDSPeakExe ?>
		<ExePackage Id="IDSPeakRuntime"
					SourceFile="$(var.IDSPeakExe)"
					Permanent="yes"
					PerMachine="yes"
					InstallArguments='/s /f1"$(var.IDSPeakSetupIss)"'
					DetectCondition="0" />
		<?endif ?>
    </Chain>
  </Bundle>
</Wix>
